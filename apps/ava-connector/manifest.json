{
  "manifest_version": 3,
  "name": "Konea · Conector AVA experimental",
  "description": "Exporta materias y actividades visibles de AVA para revisarlas antes de importarlas en Konea.",
  "version": "0.1.0",
  "minimum_chrome_version": "109",
  "permissions": ["activeTab", "scripting", "downloads"],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_title": "Capturar AVA para Konea",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png"
    }
  }
}
