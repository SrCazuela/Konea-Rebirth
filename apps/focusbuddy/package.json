{
  "name": "@konea/focusbuddy",
  "version": "0.1.1",
  "private": true,
  "description": "Cliente de escritorio FocusBuddy para las sesiones de estudio de Konea.",
  "author": "Konea Capstone",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/run-development.cjs",
    "build": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/companion-preload.cjs && node --check electron/avatar-animation.js && node --check electron/avatar-library.js && node --check electron/companion.js && node --check electron/desktop.js && node --check electron/api-url.cjs && node --check electron/desktop-api.cjs && node --check electron/preferences.cjs && node --check electron/session-state.cjs && node --check electron/window-options.cjs && node --check scripts/after-pack.cjs && node --check scripts/fuse-policy.cjs && node --check scripts/prepare-release-config.cjs && node --check scripts/run-development.cjs && node --check scripts/run-electron-builder.cjs && node --check scripts/verify-release.cjs && node --check scripts/sync-branding.cjs && node --check electron/release-channel.cjs && node --check scripts/build-release.cjs",
    "test": "node --test electron/*.test.cjs",
    "dist": "node scripts/build-release.cjs --channel=local",
    "dist:dir": "node scripts/build-release.cjs --channel=local --target=dir",
    "verify:release": "node scripts/verify-release.cjs",
    "branding:sync": "node scripts/sync-branding.cjs",
    "predev": "node scripts/sync-branding.cjs",
    "predist": "node scripts/sync-branding.cjs",
    "predist:dir": "node scripts/sync-branding.cjs",
    "dist:local": "node scripts/build-release.cjs --channel=local",
    "dist:local:dir": "node scripts/build-release.cjs --channel=local --target=dir",
    "dist:production": "node scripts/build-release.cjs --channel=production",
    "dist:production:dir": "node scripts/build-release.cjs --channel=production --target=dir",
    "predist:local": "node scripts/sync-branding.cjs",
    "predist:local:dir": "node scripts/sync-branding.cjs",
    "predist:production": "node scripts/sync-branding.cjs",
    "predist:production:dir": "node scripts/sync-branding.cjs"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "electron": "44.11.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "cl.konea.focusbuddy.local",
    "productName": "Konea FocusBuddy Local",
    "protocols": [
      {
        "name": "Konea FocusBuddy Local",
        "schemes": [
          "konea-focusbuddy-local"
        ]
      }
    ],
    "artifactName": "Konea-FocusBuddy-Local-${version}-${arch}.${ext}",
    "directories": {
      "output": "release/local"
    },
    "files": [
      "electron/api-url.cjs",
      "electron/assets/avatar-hq/*.png",
      "electron/assets/avatar-hq/source-manifest.json",
      "electron/assets/branding/konea-logo.svg",
      "electron/assets/branding/konea-mark.svg",
      "electron/avatar-animation.js",
      "electron/avatar-library.js",
      "electron/companion.css",
      "electron/companion.html",
      "electron/companion.js",
      "electron/companion-preload.cjs",
      "electron/desktop-api.cjs",
      "electron/desktop.css",
      "electron/desktop.html",
      "electron/desktop.js",
      "electron/main.cjs",
      "electron/owl-shimeji-provisional.png",
      "electron/preload.cjs",
      "electron/preferences.cjs",
      "electron/release-channel.cjs",
      "electron/session-state.cjs",
      "electron/window-options.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/local/focusbuddy.config.json",
        "to": "focusbuddy.config.json"
      },
      {
        "from": "build/icon.png",
        "to": "focusbuddy-icon.png"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
