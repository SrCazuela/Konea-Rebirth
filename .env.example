# PostgreSQL local. Never use these sample credentials in production.
POSTGRES_DB=konea
POSTGRES_USER=konea
POSTGRES_PASSWORD=replace_me_for_local_development
POSTGRES_PORT=5432
DATABASE_URL=postgresql://konea:replace_me_for_local_development@localhost:5432/konea

# API
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
# Set to 1 only when the API is directly behind one trusted reverse proxy.
TRUST_PROXY_HOPS=0
CORS_ORIGIN=http://localhost:5173
WRITE_RATE_LIMIT_PER_15_MIN=600
SESSION_TTL_DAYS=7
POSTS_REQUIRE_APPROVAL=false
# Local files remain on disk. Hosted deployments use a PRIVATE S3-compatible
# bucket and keep all file access behind Konea's authenticated upload API.
UPLOAD_STORAGE=filesystem
# UPLOAD_DIRECTORY=D:/konea-rebirth/Konea-Rebirth/.local/uploads
# S3_ENDPOINT=https://branch.storage.region.aws.neon.tech
# S3_REGION=us-east-2
# S3_BUCKET=konea-private
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Set only on the hosted backend and Sites server, never in VITE_* or desktop.
# SITES_BACKEND_TOKEN=<random secret with at least 32 characters>
SEED_SOCIAL_DEMO=true
# Adds presentation-ready chats, requests, tasks and FocusBuddy history locally.
SEED_CAPSTONE_DEMO=true
# Optional: username that receives the personal demo data. If omitted, Konea
# chooses the active non-demo student with the most local academic activity.
# CAPSTONE_DEMO_USERNAME=

# DUCO AI. Use local for deterministic fallback, ollama for local AI, or
# openai after adding API credits. Never expose OPENAI_API_KEY to the web app.
DUCO_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_KEEP_ALIVE=2m
DUCO_AI_TIMEOUT_MS=120000
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=45000

# Web. Leave empty to use Vite's /api development proxy.
VITE_API_URL=/api/v1
# Optional HTTPS URL to the stable Windows x64 installer published in a release.
VITE_FOCUSBUDDY_DOWNLOAD_URL=
