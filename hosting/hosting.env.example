# Copy to the ignored repository-root .env.hosting.local for migration tooling.
# Never replace the local .env. Never commit filled credentials.
# Use a NEW EMPTY Neon PostgreSQL database; restore before starting Render.
HOSTED_DATABASE_URL=

# Private Neon Object Storage bucket, separate from local .local/uploads.
S3_ENDPOINT=
S3_REGION=us-east-2
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Shared only by Sites and Render, never the browser/desktop application.
SITES_BACKEND_TOKEN=
